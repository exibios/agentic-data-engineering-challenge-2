# =============================================================================
# Google Cloud Project & Location Configuration
# =============================================================================
PROJECT_ID=your-project-id
GCP_PROJECT=your-project-id
LOCATION=global
GCP_LOCATION=global
REGION=us-central1

# =============================================================================
# Model Selection & Vertex AI Configuration
# =============================================================================
MODEL_NAME=gemini-3.8-flash
AGENT_MODEL=gemini-3.8-flash
GOOGLE_GENAI_USE_VERTEXAI=True
EMBEDDING_MODEL=embedding_model
EXTRACTOR_MODEL=model_extractor

# =============================================================================
# BigQuery & Google Cloud Storage Configuration
# =============================================================================
DATASET_ID=clinical_trials_2
BQ_DATASET=clinical_trials_2
TABLE_ID=studies_metadata
BQ_TABLE=studies_metadata
BUCKET_NAME=your-gcs-bucket-name
GCS_BUCKET=your-gcs-bucket-name

# =============================================================================
# Pub/Sub, Eventarc, & DLQ Configuration
# =============================================================================
DLQ_TOPIC_ID=clinical-trials-ingest-dlq
DWL_TOPIC_ID=clinical-trials-ingest-dlq
INGEST_TOPIC_ID=clinical-trials-ingest-topic
DLQ_SUBSCRIPTION_ID=clinical-trials-ingest-dlq-sub
INGEST_SUBSCRIPTION_ID=clinical-trials-ingest-sub

# =============================================================================
# API Service & Memory Configuration
# =============================================================================
RAG_API_URL=http://localhost:8080/search
SERVICE_NAME=clinical-trials-rag-api
FIRESTORE_COLLECTION=agent_sessions
